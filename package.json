{
  "name": "fastfetch-spotify-canvas",
  "version": "2.0.0",
  "description": "Show the Spotify canvas (or album cover) of your current track as the fastfetch logo",
  "type": "module",
  "scripts": {
    "build": "tsup --entry.index src/index.ts --entry.login src/auth/login.ts --format esm --out-dir dist --clean",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "auth": "node dist/login.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.5.2",
  "dependencies": {
    "otpauth": "^9.5.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
