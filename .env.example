# sp_dc cookie from open.spotify.com (used for the canvas)
SP_DC=

# from your app at https://developer.spotify.com/dashboard (used for now-playing)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# filled in by `pnpm run auth`
SPOTIFY_REFRESH_TOKEN=

# optional: alternative source for the web player TOTP secrets (same JSON format)
# SPOTIFY_SECRETS_URL=
